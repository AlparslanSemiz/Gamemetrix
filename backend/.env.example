ENV=development
DATABASE_URL=postgresql+psycopg://gamemetrix:change-me@localhost:5432/gamemetrix

# Admin login / JWT
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=gamemetrix-api
JWT_AUDIENCE=gamemetrix-admin
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Public API and authentication rate limiting
PUBLIC_READ_RATE_LIMIT=300/minute
AUTH_RATE_LIMIT=5/minute
RATE_LIMIT_STORAGE_URI=memory://

# Visitor analytics. Raw IPs are admin-only and redacted after the retention window.
# Enable trusted headers only when the backend is reachable exclusively through a proxy
# that overwrites CF-Connecting-IP, X-Real-IP, and X-Forwarded-For.
ANALYTICS_STORE_RAW_IP=false
ANALYTICS_TRUST_PROXY_HEADERS=false
ANALYTICS_RAW_IP_RETENTION_DAYS=30

# Normal user accounts (separate from the admin JWT login)
ACCOUNT_AUTH_ENABLED=true
ACCOUNT_SESSION_DAYS=30
ACCOUNT_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/account/oauth/google/callback
ACCOUNT_EMAIL_DELIVERY=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=accounts@gamemetrix.me
SMTP_FROM_NAME=GameMetrix
SMTP_START_TLS=true

# Rating and metadata providers
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=
OPENCRITIC_API_BASE=https://opencritic-api.p.rapidapi.com
# Use this only after OpenCritic grants a direct read license/key.
OPENCRITIC_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_HOST=opencritic-api.p.rapidapi.com
ITAD_API_KEY=
STEAM_WEB_API_KEY=
# GameBrain free is non-commercial and its default terms do not permit our
# persistent metadata cache. Enable only after written cache/retention approval.
GAMEBRAIN_API_KEY=
GAMEBRAIN_NONCOMMERCIAL_ENABLED=false
GAMEBRAIN_CACHE_PERMISSION_GRANTED=false
# AI text generation. Calls stay server-side and use the ordered fallback chain.
AI_PROVIDER_ORDER=groq,gemini,cloudflare,openrouter
AI_PROVIDER_TIMEOUT_SECONDS=10
AI_BACKGROUND_DEADLINE_SECONDS=60
AI_INTERACTIVE_DEADLINE_SECONDS=15
AI_MAX_CONCURRENCY=2
AI_MAX_PROMPT_CHARS=16000
AI_MAX_OUTPUT_TOKENS=1024

# Groq — primary provider.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MIN_REQUEST_INTERVAL_SECONDS=12

# Gemini — stable, high-volume Flash-Lite fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=6

# Cloudflare Workers AI — both values are required.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-20b

# OpenRouter — final fallback; keep the free router unless intentionally changed.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Persistent daily request budgets
# RapidAPI Basic: 200 requests/day, 25 searches/day, 4 req/s hard limits.
# These local caps leave small headroom and do not permit commercial use.
OPENCRITIC_DAILY_LIMIT=190
OPENCRITIC_SEARCH_DAILY_LIMIT=24
OPENCRITIC_PER_SECOND_LIMIT=3
IGDB_DAILY_LIMIT=3000
RAWG_DAILY_LIMIT=600
RAWG_MONTHLY_LIMIT=20000
RAWG_MONTHLY_RESET_DAY=25
ITAD_FIVE_MINUTE_LIMIT=1000
PROVIDER_BUDGET_RESERVE_PERCENT=15
STEAM_DAILY_LIMIT=1500
STEAMSPY_DAILY_LIMIT=300
CHEAPSHARK_DAILY_LIMIT=200
FREETOGAME_DAILY_LIMIT=200
ITAD_DAILY_LIMIT=200
HLTB_DAILY_LIMIT=250
WIKIDATA_DAILY_LIMIT=200
GAMEBRAIN_DAILY_LIMIT=40
# Free gpt-oss-20b tier: 1,000 requests/day but only 200,000 tokens/day, and
# catalog prompts run out of tokens first — so the token ceiling is the real
# budget. Raise both to your tier's RPD/TPD on a paid plan; neither is capped
# in code. Both are shared across all AI jobs.
GROQ_DAILY_LIMIT=1000
GROQ_DAILY_TOKEN_LIMIT=200000
GEMINI_DAILY_LIMIT=100
GEMINI_DAILY_TOKEN_LIMIT=100000
CLOUDFLARE_AI_DAILY_LIMIT=100
CLOUDFLARE_AI_DAILY_TOKEN_LIMIT=100000
OPENROUTER_DAILY_LIMIT=50
OPENROUTER_DAILY_TOKEN_LIMIT=100000
# Optional similarity AI remains off by default. If enabled, it has an
# additional low-volume budget and per-process request interval.
SIMILARITY_USE_AI=false
SIMILARITY_AI_DAILY_LIMIT=25
SIMILARITY_AI_MIN_INTERVAL_SECONDS=2
HLTB_REQUEST_DELAY_SECONDS=1.5

# Automated catalog and data completion
STARTUP_CATALOG_MAINTENANCE_ENABLED=false
DATA_FILL_ENABLED=true
DATA_FILL_TARGET_TOTAL=50000
DATA_FILL_INTERVAL_HOURS=24
DATA_FILL_STARTUP_DELAY_SECONDS=120
STARTUP_RATING_REFRESH_LIMIT=0
STARTUP_METADATA_BACKFILL_LIMIT=0
SUMMARY_SHORTEN_STARTUP_LIMIT=0
# Descriptions audited per cycle, and how many of them may cost a Groq call.
# Deterministic clean-up is free; GROQ_DAILY_TOKEN_LIMIT is the shared ceiling.
SUMMARY_SHORTEN_INTERVAL_MINUTES=30
SUMMARY_SHORTEN_BATCH_SIZE=40
SUMMARY_QUALITY_AI_LIMIT=4
DATA_FILL_PRIMARY_SCORE_BATCH_SIZE=10000
DATA_FILL_METADATA_BATCH_SIZE=48
DATA_FILL_RATING_BATCH_SIZE=48
DATA_FILL_PRICE_BATCH_SIZE=48
DATA_FILL_HLTB_TARGET=5000
DATA_FILL_INTER_GAME_DELAY=0.35
CATALOG_QUALITY_BATCH_SIZE=40
CATALOG_REPAIR_BATCH_SIZE=10
SEO_INDEX_LIMIT=500
