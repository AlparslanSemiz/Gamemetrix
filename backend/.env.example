ENV=development
DATABASE_URL=postgresql+psycopg://gamemetrix:change-me@localhost:5432/gamemetrix

# Admin login / JWT
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=gamemetrix-api
JWT_AUDIENCE=gamemetrix-admin
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Public API and authentication rate limiting
PUBLIC_READ_RATE_LIMIT=300/minute
AUTH_RATE_LIMIT=5/minute
RATE_LIMIT_STORAGE_URI=memory://

# Visitor analytics. Raw IPs are admin-only and redacted after the retention window.
# Enable trusted headers only when the backend is reachable exclusively through a proxy
# that overwrites CF-Connecting-IP, X-Real-IP, and X-Forwarded-For.
ANALYTICS_STORE_RAW_IP=false
ANALYTICS_TRUST_PROXY_HEADERS=false
ANALYTICS_RAW_IP_RETENTION_DAYS=30

# Normal user accounts (separate from the admin JWT login)
ACCOUNT_AUTH_ENABLED=true
ACCOUNT_SESSION_DAYS=30
ACCOUNT_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/account/oauth/google/callback
ACCOUNT_EMAIL_DELIVERY=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=accounts@gamemetrix.me
SMTP_FROM_NAME=GameMetrix
SMTP_START_TLS=true

# Rating and metadata providers
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=
OPENCRITIC_API_BASE=https://opencritic-api.p.rapidapi.com
# Use this only after OpenCritic grants a direct read license/key.
OPENCRITIC_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_HOST=opencritic-api.p.rapidapi.com
ITAD_API_KEY=
STEAM_WEB_API_KEY=
# GameBrain free is non-commercial and its default terms do not permit our
# persistent metadata cache. Enable only after written cache/retention approval.
GAMEBRAIN_API_KEY=
GAMEBRAIN_NONCOMMERCIAL_ENABLED=false
GAMEBRAIN_CACHE_PERMISSION_GRANTED=false
# Groq — rewrites summaries and reviews suspicious catalog metadata.
# Free key from https://console.groq.com/keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Persistent daily request budgets
OPENCRITIC_DAILY_LIMIT=4
OPENCRITIC_SEARCH_DAILY_LIMIT=2
IGDB_DAILY_LIMIT=3000
RAWG_DAILY_LIMIT=600
RAWG_MONTHLY_LIMIT=20000
RAWG_MONTHLY_RESET_DAY=25
ITAD_FIVE_MINUTE_LIMIT=1000
PROVIDER_BUDGET_RESERVE_PERCENT=15
STEAM_DAILY_LIMIT=1500
STEAMSPY_DAILY_LIMIT=300
CHEAPSHARK_DAILY_LIMIT=200
FREETOGAME_DAILY_LIMIT=200
ITAD_DAILY_LIMIT=200
HLTB_DAILY_LIMIT=250
WIKIDATA_DAILY_LIMIT=200
GAMEBRAIN_DAILY_LIMIT=40
HLTB_REQUEST_DELAY_SECONDS=1.5

# Automated catalog and data completion
DATA_FILL_ENABLED=true
DATA_FILL_TARGET_TOTAL=50000
DATA_FILL_INTERVAL_HOURS=24
DATA_FILL_STARTUP_DELAY_SECONDS=120
STARTUP_RATING_REFRESH_LIMIT=0
STARTUP_METADATA_BACKFILL_LIMIT=0
DATA_FILL_PRIMARY_SCORE_BATCH_SIZE=10000
DATA_FILL_METADATA_BATCH_SIZE=48
DATA_FILL_RATING_BATCH_SIZE=48
DATA_FILL_PRICE_BATCH_SIZE=48
DATA_FILL_HLTB_TARGET=5000
DATA_FILL_INTER_GAME_DELAY=0.35
CATALOG_QUALITY_BATCH_SIZE=40
CATALOG_REPAIR_BATCH_SIZE=40
NONGAME_AUTODELETE_ENABLED=false
SEO_INDEX_LIMIT=50000
