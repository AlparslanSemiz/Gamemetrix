{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc -b",
    "build": "react-router typegen && tsc -b && react-router build",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "lighthouse:ci": "npm run build && node tests/lighthouse-ci.mjs",
    "start": "react-router-serve ./build/server/index.js",
    "preview": "npm run start"
  },
  "dependencies": {
    "@react-router/node": "8.5.2",
    "@react-router/serve": "8.5.2",
    "isbot": "^5.2.3",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@react-router/dev": "8.5.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.1.0"
  },
  "overrides": {
    "lighthouse": {
      "@sentry/node": "10.66.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
