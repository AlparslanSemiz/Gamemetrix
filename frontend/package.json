{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc -b",
    "build": "react-router typegen && tsc -b && react-router build",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "lighthouse:ci": "npm run build && node tests/lighthouse-ci.mjs",
    "start": "react-router-serve ./build/server/index.js",
    "preview": "npm run start"
  },
  "dependencies": {
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "isbot": "^5",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "lighthouse": "^13.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.1.0"
  },
  "overrides": {
    "lighthouse": {
      "@sentry/node": "10.66.0"
    }
  }
}
